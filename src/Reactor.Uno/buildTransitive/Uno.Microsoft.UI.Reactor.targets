<Project>
  <!--
    Android entry point (ReactorAndroidEntry).

    Android never calls Main, and the Android SDK compiles an app as a Library
    (it rewrites OutputType Exe to Library), so top-level statements don't even
    compile there (CS8805). That forces an `#if __ANDROID__` around
    ReactorApp.Run plus a Platforms/Android Application + Activity.

    With ReactorAndroidEntry=true the app keeps one Program.cs for every target:
    - the compiler builds the app as an Exe, so it has an entry point; OutputType
      goes back to Library right after, for the Android targets that read it;
    - ReactorAndroidEntry.cs adds the [Application] and launcher [Activity]; the
      Application runs Main, where ReactorApp.Run records its options and returns;
    - like the unoapp template's Platforms/Android files, the Application takes the
      launcher icon from UnoIcon and the splash theme from UnoSplashScreen (both
      Uno.Resizetizer items); the themes are Android resources shipped here, so the
      app needs no Styles.xml.

    On by default. An app that starts itself from its own NativeApplication (the
    shape before this existed) sets ReactorAndroidEntry=false to keep it; while the
    entry is on, _ReactorCheckAndroidEntryConflict turns that leftover into an
    error that says so, instead of CS5001 or two [Application] types.
  -->
  <PropertyGroup>
    <ReactorAndroidEntry Condition="'$(ReactorAndroidEntry)' == ''">true</ReactorAndroidEntry>
    <_ReactorAndroidEntry Condition="'$(AndroidApplication)' == 'true' and '$(ReactorAndroidEntry)' == 'true'">true</_ReactorAndroidEntry>
    <_ReactorAndroidEntryConfigFile>$(IntermediateOutputPath)ReactorAndroidEntry.g.cs</_ReactorAndroidEntryConfigFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(_ReactorAndroidEntry)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)ReactorAndroidEntry.cs" Link="ReactorAndroidEntry.cs" Visible="false" />
  </ItemGroup>

  <Target Name="_ReactorGenerateAndroidEntryConfig"
          BeforeTargets="CoreCompile"
          Condition="'$(_ReactorAndroidEntry)' == 'true'">
    <PropertyGroup>
      <!-- Uno.Resizetizer names the launcher mipmap after the UnoIcon file (icon.svg → @mipmap/icon). -->
      <_ReactorAndroidIconName>@(UnoIcon->'%(Filename)')</_ReactorAndroidIconName>
      <_ReactorAndroidIcon>null</_ReactorAndroidIcon>
      <_ReactorAndroidIcon Condition="'$(_ReactorAndroidIconName)' != '' and !$(_ReactorAndroidIconName.Contains(';'))">"@mipmap/$(_ReactorAndroidIconName)"</_ReactorAndroidIcon>
      <_ReactorAndroidHasSplash>false</_ReactorAndroidHasSplash>
      <_ReactorAndroidHasSplash Condition="'@(UnoSplashScreen)' != ''">true</_ReactorAndroidHasSplash>
      <_ReactorAndroidTheme>"@style/Reactor.Theme"</_ReactorAndroidTheme>
      <_ReactorAndroidTheme Condition="'$(_ReactorAndroidHasSplash)' == 'true'">"@style/Reactor.Theme.Starting"</_ReactorAndroidTheme>
    </PropertyGroup>

    <ItemGroup>
      <_ReactorAndroidEntryConfigLine Include="// Generated by Uno.Microsoft.UI.Reactor.targets from the app's UnoIcon and UnoSplashScreen items." />
      <_ReactorAndroidEntryConfigLine Include="#nullable enable" />
      <_ReactorAndroidEntryConfigLine Include="namespace Microsoft.UI.Reactor.AndroidEntry" />
      <_ReactorAndroidEntryConfigLine Include="{" />
      <_ReactorAndroidEntryConfigLine Include="    internal static class ReactorAndroidEntryConfig" />
      <_ReactorAndroidEntryConfigLine Include="    {" />
      <_ReactorAndroidEntryConfigLine Include="        public const string%3F Icon =$(_ReactorAndroidIcon)%3B" />
      <_ReactorAndroidEntryConfigLine Include="        public const string Theme = $(_ReactorAndroidTheme)%3B" />
      <!-- Not const: a const false makes the splash call unreachable (CS0162), a warning in every app without a splash. -->
      <_ReactorAndroidEntryConfigLine Include="        public static readonly bool HasSplashScreen = $(_ReactorAndroidHasSplash)%3B" />
      <_ReactorAndroidEntryConfigLine Include="    }" />
      <_ReactorAndroidEntryConfigLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(_ReactorAndroidEntryConfigFile)"
                      Lines="@(_ReactorAndroidEntryConfigLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_ReactorAndroidEntryConfigFile)" />
      <FileWrites Include="$(_ReactorAndroidEntryConfigFile)" />
    </ItemGroup>
  </Target>

  <!-- The themes, as a library resource directory, the way Uno.Resizetizer adds its
       generated icon and splash resources. Copied under obj/ first: the Android build
       rewrites the files of a resource directory in place, and these ship in the
       read-only package folder. The splash theme only goes in with a UnoSplashScreen:
       it refers to the resources Uno.Resizetizer generates from it. -->
  <Target Name="_ReactorAddAndroidEntryResources"
          BeforeTargets="_ComputeAndroidResourcePaths;_CollectLibraryResourceDirectories"
          Condition="'$(_ReactorAndroidEntry)' == 'true'">
    <PropertyGroup>
      <_ReactorAndroidEntryResDir>$(IntermediateOutputPath)reactor-android-entry\res\</_ReactorAndroidEntryResDir>
    </PropertyGroup>
    <ItemGroup>
      <_ReactorAndroidEntryResource Include="$(MSBuildThisFileDirectory)android\theme\values\reactor_entry_theme.xml" />
      <_ReactorAndroidEntryResource Include="$(MSBuildThisFileDirectory)android\splash\values\reactor_entry_splash.xml" Condition="'@(UnoSplashScreen)' != ''" />
      <_ReactorAndroidEntryStaleResource Include="$(_ReactorAndroidEntryResDir)values\reactor_entry_splash.xml" Condition="'@(UnoSplashScreen)' == ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_ReactorAndroidEntryResource)"
          DestinationFolder="$(_ReactorAndroidEntryResDir)values"
          SkipUnchangedFiles="true" />
    <Delete Files="@(_ReactorAndroidEntryStaleResource)" />
    <ItemGroup>
      <LibraryResourceDirectories Include="$(_ReactorAndroidEntryResDir)">
        <StampFile>$(MSBuildThisFileFullPath)</StampFile>
      </LibraryResourceDirectories>
      <FileWrites Include="$(_ReactorAndroidEntryResDir)values\*.xml" />
    </ItemGroup>
  </Target>

  <!-- An app still carrying its own NativeApplication (Uno.Sdk's Platforms/Android
       folder, as the unoapp-reactor template generated it) would otherwise fail with
       CS5001, since its Program.cs leaves Android out, or with two [Application]
       types. Only that folder is read, so this costs a few small files. -->
  <Target Name="_ReactorCheckAndroidEntryConflict"
          BeforeTargets="CoreCompile"
          Condition="'$(_ReactorAndroidEntry)' == 'true'">
    <ItemGroup>
      <_ReactorOwnAndroidApplication Include="@(Compile)"
          Condition="$([System.String]::Copy('%(Compile.Identity)').StartsWith('$(AndroidProjectFolder)')) and Exists('%(Compile.FullPath)') and $([System.IO.File]::ReadAllText('%(Compile.FullPath)').Contains('NativeApplication'))" />
    </ItemGroup>
    <Error Condition="'@(_ReactorOwnAndroidApplication)' != ''"
           Code="REACTORUNO0001"
           Text="@(_ReactorOwnAndroidApplication) starts the app from its own NativeApplication, but Reactor now provides the Android Application and Activity (ReactorAndroidEntry). Either delete that file and the Activity next to it, and call ReactorApp.Run on Android too (drop the `#if __ANDROID__` in Program.cs); or keep them and set &lt;ReactorAndroidEntry&gt;false&lt;/ReactorAndroidEntry&gt; in the project." />
  </Target>

  <Target Name="_ReactorCompileAndroidAsExe"
          BeforeTargets="CoreCompile"
          Condition="'$(_ReactorAndroidEntry)' == 'true' and '$(OutputType)' == 'Library'">
    <PropertyGroup>
      <OutputType>Exe</OutputType>
      <_ReactorRestoreLibraryOutputType>true</_ReactorRestoreLibraryOutputType>
    </PropertyGroup>
  </Target>

  <Target Name="_ReactorRestoreAndroidOutputType"
          AfterTargets="CoreCompile"
          Condition="'$(_ReactorRestoreLibraryOutputType)' == 'true'">
    <PropertyGroup>
      <OutputType>Library</OutputType>
      <_ReactorRestoreLibraryOutputType />
    </PropertyGroup>
  </Target>
</Project>
