<?xml version="1.0" encoding="utf-8" ?>
<!-- The starting theme ReactorAndroidEntry uses when the app has a UnoSplashScreen;
     the same as the unoapp template's Theme.App.Starting. Only added then, since
     uno_splash_color and uno_splash_image are generated by Uno.Resizetizer from it. -->
<resources>
	<style name="Reactor.Theme.Starting" parent="Theme.SplashScreen">
		<item name="android:windowSplashScreenBackground">@color/uno_splash_color</item>
		<item name="android:windowBackground">@drawable/uno_splash_image</item>
		<item name="android:windowSplashScreenAnimatedIcon">@drawable/uno_splash_image</item>

		<item name="postSplashScreenTheme">@style/Reactor.Theme</item>
	</style>
</resources>
